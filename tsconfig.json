{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@surdeddd/wmkit": ["./src/index.ts"],
      "@surdeddd/wmkit/react": ["./src/adapters/react.ts"],
      "@surdeddd/wmkit/vue": ["./src/adapters/vue.ts"],
      "@surdeddd/wmkit/svelte": ["./src/adapters/svelte.ts"],
      "@surdeddd/wmkit/solid": ["./src/adapters/solid.ts"],
      "@surdeddd/wmkit/persist": ["./src/plugins/persist.ts"],
      "@surdeddd/wmkit/popout": ["./src/plugins/popout.ts"],
      "@surdeddd/wmkit/devtools": ["./src/plugins/devtools/index.ts"],
      "@surdeddd/wmkit/gestures": ["./src/plugins/gestures.ts"],
      "@surdeddd/wmkit/chrome": ["./src/plugins/chrome/index.ts"],
      "@surdeddd/wmkit/winbox": ["./src/plugins/winbox/index.ts"],
      "@surdeddd/wmkit/dock": ["./src/plugins/dock/index.ts"],
      "@surdeddd/wmkit/elements": ["./src/plugins/elements/index.ts"],
      "@surdeddd/wmkit/elements/define": ["./src/plugins/elements/define.ts"],
      "@surdeddd/wmkit/themes": ["./src/themes/index.ts"],
      "@surdeddd/wmkit/angular": ["./src/adapters/angular.ts"],
      "@surdeddd/wmkit/preact": ["./src/adapters/preact.ts"],
      "@surdeddd/wmkit/lit": ["./src/adapters/lit.ts"],
      "@surdeddd/wmkit/qwik": ["./src/adapters/qwik.ts"]
    }
  },
  "include": [
    "src",
    "tests",
    "site/src",
    "site/test",
    "templates/dashboard/src",
    "site/vite.config.ts",
    "tsup.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist", "site/dist"]
}
