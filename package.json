      "ignore": [
        "lit"
      ]
    },
    {
      "name": "qwik adapter",
      "path": "dist/qwik.qwik.mjs",
      "limit": "17 kB",
      "ignore": [
        "@builder.io/qwik"
      ]
    },
    {
      "name": "persist plugin",
      "path": "dist/persist.js",
      "limit": "1 kB"
    },
    {
      "name": "popout plugin",
      "path": "dist/popout.js",
      "limit": "2.5 kB"
    },
    {
      "name": "gestures plugin",
      "path": "dist/gestures.js",
      "limit": "2 kB"
    },
    {
      "name": "devtools plugin",
      "path": "dist/devtools.js",
      "limit": "5 kB"
    },
    {
      "name": "chrome plugin",
      "path": "dist/chrome.js",
      "limit": "3 kB"
    },
    {
      "name": "winbox compat",
      "path": "dist/winbox.js",
      "limit": "21 kB"
    },
    {
      "name": "dock plugin",
      "path": "dist/dock.js",
      "limit": "6 kB"
    },
    {
      "name": "web components",
      "path": "dist/elements.js",
      "limit": "19 kB"
    },
    {
      "name": "themes as text",
      "path": "dist/themes.js",
      "limit": "8 kB"
    }
  ],
