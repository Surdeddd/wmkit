      "import": {
        "types": "./dist/elements/define.d.ts",
        "default": "./dist/elements/define.js"
      },
      "require": {
        "types": "./dist/elements/define.d.cts",
        "default": "./dist/elements/define.cjs"
      }
    },
    "./themes": {
      "import": {
        "types": "./dist/themes.d.ts",
        "default": "./dist/themes.js"
      },
      "require": {
        "types": "./dist/themes.d.cts",
        "default": "./dist/themes.cjs"
      }
    },
    "./themes/*": "./dist/themes/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && vite build -c vite.qwik.config.ts --mode lib && tsc -p tsconfig.qwik.json && node -e \"require('node:fs').copyFileSync('dist/qwik.d.ts','dist/qwik.d.cts')\"",
    "themes": "node scripts/themes.mjs",
    "dev": "vite site",
    "site:build": "vite build site && vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "qwik:fixture": "vite build -c tests/fixtures/qwik/vite.config.ts",
    "dashboard:fixture": "vite build -c tests/fixtures/dashboard/vite.config.ts",
    "site:preview": "vite preview site",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "attw": "attw --pack .",
    "publint": "publint",
    "prepublishOnly": "pnpm build",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm size && pnpm publint && pnpm attw && pnpm test:e2e",
    "release": "semantic-release",
    "bench": "vitest bench --run"
  },
  "peerDependencies": {
    "@angular/core": ">=16",
    "@builder.io/qwik": ">=1.5 <2",
    "lit": ">=3",
    "preact": ">=10",
    "react": ">=18",
    "solid-js": ">=1.8",
    "svelte": ">=4",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "lit": {
      "optional": true
    },
    "@builder.io/qwik": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/core": "^20.3.26",
    "@arethetypeswrong/cli": "^0.18.2",
    "@axe-core/playwright": "^4.10.2",
    "@biomejs/biome": "^2.0.0",
    "@builder.io/qwik": "^1.20.2",
    "@playwright/test": "^1.53.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "lit": "^3.3.3",
    "preact": "^11.0.2",
    "publint": "^0.3.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "semantic-release": "^25.0.6",
    "size-limit": "^11.2.0",
    "solid-js": "^1.9.7",
    "svelte": "^5.35.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitepress": "1.6.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.17"
  },
  "size-limit": [
    {
      "name": "core",
      "path": "dist/index.js",
      "limit": "16 kB"
    },
    {
      "name": "react adapter",
      "path": "dist/react.js",
      "limit": "16.5 kB",
      "ignore": [
        "react"
      ]
    },
    {
      "name": "vue adapter",
      "path": "dist/vue.js",
      "limit": "16.5 kB",
      "ignore": [
        "vue"
      ]
    },
    {
      "name": "svelte adapter",
      "path": "dist/svelte.js",
      "limit": "16.5 kB",
      "ignore": [
