  "scripts": {
    "build": "tsup && node scripts/winbox-cjs.mjs && vite build -c vite.qwik.config.ts --mode lib && tsc -p tsconfig.qwik.json && node -e \"require('node:fs').copyFileSync('dist/qwik.d.ts','dist/qwik.d.cts')\"",
    "themes": "node scripts/themes.mjs",
    "llms": "node scripts/llms.mjs",
    "dev": "vite site",
    "site:build": "vite build site && vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "qwik:fixture": "vite build -c tests/fixtures/qwik/vite.config.ts",
    "dashboard:fixture": "vite build -c tests/fixtures/dashboard/vite.config.ts",
    "site:preview": "vite preview site",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "attw": "attw --pack .",
    "publint": "publint",
    "smoke": "node scripts/consumer-smoke.mjs",
    "smoke:template": "node scripts/consumer-smoke.mjs --template",
    "smoke:peers": "node scripts/peer-floors.mjs",
    "smoke:builds": "node scripts/consumer-builds.mjs",
    "prepublishOnly": "pnpm build",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm size && pnpm publint && pnpm attw && pnpm smoke && pnpm test:e2e",
    "release": "semantic-release",
    "bench": "vitest bench --run",
    "bench:browser": "node scripts/bench-browser.mjs"
  },
